{
  "schemaVersion": 1,
  "id": "points-addon",
  "version": "${version}",
  "name": "Points Addon",
  "description": "Точки из points.txt удаляются, когда игрок до них добирается.",
  "authors": ["you"],
  "environment": "client",
  "entrypoints": {
    "meteor": ["ru.example.points.PointsAddon"]
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*"
  },
  "custom": {
    "meteor-client:color": "0,255,180",
    "modmenu.parent.id": "meteor-client"
  }
}
